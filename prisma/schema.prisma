generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url=env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String   @unique
  password  String
  phone     String?
  devices   Device[]
  trips     Trip[]
  createdAt DateTime @default(now())
}

model Device {
  id               Int               @id @default(autoincrement())
  deviceUuid       String            @unique
  model            String?
  firmwareVersion  String?
  user             User?             @relation(fields: [userId], references: [id])
  userId           Int?
  trips            Trip[]
  drowsinessEvents DrowsinessEvent[]
  createdAt        DateTime          @default(now())
}

model Trip {
  id        Int               @id @default(autoincrement())
  device    Device            @relation(fields: [deviceId], references: [id])
  deviceId  Int
  user      User?             @relation(fields: [userId], references: [id])
  userId    Int?
  startedAt DateTime
  endedAt   DateTime?
  events    DrowsinessEvent[]
}

model DrowsinessEvent {
  id          Int      @id @default(autoincrement())
  trip        Trip     @relation(fields: [tripId], references: [id])
  tripId      Int
  device      Device   @relation(fields: [deviceId], references: [id])
  deviceId    Int
  timestamp   DateTime
  type        String
  severity    String
  score       Float
  eyeDuration Float?
  headTilt    Float?
  bpm         Int?
  imuFlag     Boolean?
  createdAt   DateTime @default(now())
}
